<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- AirPad collects nothing and tracks no one. Camera frames are processed
         on device by Vision and never leave the phone; input events go only to
         the user's own Mac over the local network. There is no analytics SDK,
         no account system, and no third-party network calls. -->

    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- "Required reason" APIs actually used by the app. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- UserDefaults: app settings only (sensitivity, gesture map,
                 hand calibration, trial start, known Macs). CA92.1 = access
                 info from the app itself. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <!-- CACurrentMediaTime (mach_absolute_time) drives gesture timing,
                 the pose latch, and stream watchdogs. 35F9.1 = measure elapsed
                 time between events inside the app. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
